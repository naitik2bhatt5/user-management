<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UserManagement</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The setup script is copied next to the app so it can create the database on startup. -->
    <None Include="..\database\CreateDatabase.sql" Link="Database\CreateDatabase.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
