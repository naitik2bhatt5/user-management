@model User
@inject Microsoft.Extensions.Options.IOptions<UserManagement.Services.GoogleMapsOptions> GoogleMaps
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    var addressApi = GoogleMaps.Value.Enabled;
    var isEdit = Model.UserId > 0;
    ViewData["Title"] = isEdit ? "Edit User" : "Add User";
}

<h1>@ViewData["Title"]</h1>
<p class="muted">Fields marked <span class="req">*</span> are required. U.S. addresses only.</p>

<div id="formSummary" class="alert alert-error" role="alert" hidden></div>

<form id="userForm" method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.UserId.ToString() : null)" novalidate
      data-address-api="@(addressApi ? "true" : "false")"
      data-address-on-file="@(isEdit && Context.Request.Method == "GET" ? "true" : "false")"
      data-autocomplete-url="@Url.Action("Autocomplete", "Address")"
      data-place-url="@Url.Content("~/Address/Place")"
      data-validate-url="@Url.Action("Validate", "Address")">
    <input type="hidden" asp-for="UserId" />

    <fieldset>
        <legend>Personal</legend>
        <div class="row">
            <div class="field">
                <label asp-for="FirstName">First Name <span class="req">*</span></label>
                <input asp-for="FirstName" maxlength="50" autocomplete="given-name" />
                <span asp-validation-for="FirstName" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="LastName">Last Name <span class="req">*</span></label>
                <input asp-for="LastName" maxlength="50" autocomplete="family-name" />
                <span asp-validation-for="LastName" class="field-error"></span>
            </div>
        </div>
        <div class="row">
            <div class="field">
                <label asp-for="DateOfBirth">Date of Birth <span class="req">*</span></label>
                <input asp-for="DateOfBirth" type="date" min="1900-01-01" autocomplete="bday" />
                <span id="ageHint" class="hint"></span>
                <span asp-validation-for="DateOfBirth" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Phone">Phone <span class="req">*</span></label>
                <input asp-for="Phone" type="tel" inputmode="numeric" placeholder="(555) 555-5555" autocomplete="tel-national"
                       value="@Model.PhoneFormatted" />
                <span asp-validation-for="Phone" class="field-error"></span>
            </div>
        </div>
    </fieldset>

    <fieldset>
        <legend>Address</legend>
        @if (addressApi)
        {
            <p class="google-on">Address suggestions and verification by Google are <strong>on</strong>. Start typing in Address Line 1.</p>
        }
        else if (Env.IsDevelopment())
        {
            @* Only developers see this; reviewers running without a key just get the plain form. *@
            <p class="google-off">Google address suggestions are <strong>off</strong>: no API key found.
                In Visual Studio, right-click the project, choose <em>Manage User Secrets</em>, add
                <code>{ "GoogleMaps": { "ApiKey": "AIza..." } }</code>, then restart the app.</p>
        }
        <div class="address-toolbar">
            <span id="addressStatus" class="address-status" role="status" aria-live="polite" hidden></span>
            <button type="button" id="verifyAddress" class="btn btn-small" hidden>Verify address</button>
        </div>
        <div class="field wide">
            <label asp-for="AddressLine1">Address Line 1 <span class="req">*</span></label>
            <div class="ac-wrap">
                <input asp-for="AddressLine1" maxlength="100" autocomplete="address-line1"
                       placeholder="@(addressApi ? "Start typing your street address" : "Street address")" />
                <ul id="addressSuggestions" class="ac-list" role="listbox" aria-label="Address suggestions" hidden></ul>
            </div>
            <span asp-validation-for="AddressLine1" class="field-error"></span>
        </div>
        <div class="field wide">
            <label asp-for="AddressLine2">Address Line 2</label>
            <input asp-for="AddressLine2" maxlength="100" autocomplete="address-line2" placeholder="Apt, suite, unit (optional)" />
            <span asp-validation-for="AddressLine2" class="field-error"></span>
        </div>
        <div class="row">
            <div class="field">
                <label asp-for="City">City <span class="req">*</span></label>
                <input asp-for="City" maxlength="50" autocomplete="address-level2" />
                <span asp-validation-for="City" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="StateCode">State <span class="req">*</span></label>
                <select asp-for="StateCode" asp-items="ViewBag.States" autocomplete="address-level1">
                    <option value="">-- Select state --</option>
                </select>
                <span asp-validation-for="StateCode" class="field-error"></span>
            </div>
        </div>
        <div class="row">
            <div class="field zip">
                <label asp-for="Zip5">Zip <span class="req">*</span></label>
                <input asp-for="Zip5" inputmode="numeric" maxlength="5" placeholder="12345" autocomplete="postal-code" />
                <span asp-validation-for="Zip5" class="field-error"></span>
            </div>
            <div class="field zip">
                <label asp-for="Zip4">Zip+4</label>
                <input asp-for="Zip4" inputmode="numeric" maxlength="4" placeholder="6789" />
                <span asp-validation-for="Zip4" class="field-error"></span>
            </div>
        </div>
    </fieldset>

    <div class="actions">
        <button type="submit" id="saveButton" class="btn btn-primary">@(isEdit ? "Save Changes" : "Add User")</button>
        <a id="cancelLink" class="btn" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/user-form.js" asp-append-version="true"></script>
    @if (addressApi)
    {
        <script src="~/js/address-autocomplete.js" asp-append-version="true"></script>
    }
}
